<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base App Theme (Dark) -->
    <style name="Theme.NotificationSaver" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#1C1B1F</item>
    </style>

    <!-- Starting Splash Screen Theme (Dark) -->
    <style name="Theme.NotificationSaver.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenBackground">@color/ic_launcher_final_darkmode_background</item>
        <item name="android:windowBackground">@color/ic_launcher_final_darkmode_background</item>
        <item name="postSplashScreenTheme">@style/Theme.NotificationSaver</item>
    </style>
</resources>
